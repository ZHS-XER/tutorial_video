{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "paths": {
      "@engine/*": [
        "./engine/*"
      ],
      "@youart/*": [
        "./youart/*"
      ]
    }
  },
  "include": [
    "src",
    "engine",
    "youart",
    "works",
    "lab/demos"
  ]
}